# Copy to .env (never commit .env). Use long random values, e.g.:
#   openssl rand -hex 32
# Hex keeps the database password safe inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-hex-only
# Signs the login session cookies; at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=change-me-at-least-32-characters-long
# 1 when the game is served over HTTPS (adds the Secure flag to the cookie).
COOKIE_SECURE=0
# Admin area at /admin (stats, players, audit log). Both must be set, the
# password with at least 12 characters, or the admin area stays disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-long-random
# OpenTelemetry: send traces, logs and metrics (OTLP over HTTP/protobuf) to a
# collector, e.g. the one of ClickStack. Leave empty to send nothing.
# Plain http only (no TLS client is built in); /v1/traces etc. are appended.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_SERVICE_NAME=tiny-adventurers-server
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
