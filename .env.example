# Copy to .env (never commit .env). Use long random values, e.g.:
#   openssl rand -hex 32
# Hex keeps the database password safe inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-hex-only
# Signs the login session cookies; at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=change-me-at-least-32-characters-long
# 1 when the game is served over HTTPS (adds the Secure flag to the cookie).
COOKIE_SECURE=0
